    "mac.depositsView.presentedDetail.87d31882f5": {
      "comment": "v1.5 pending English; Sources/Features/Deposits/Views/MacDepositsView.swift:134; Text, VStack, func presentedDetail",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm only after this interest has actually arrived. At maturity, this also confirms that the full principal has returned to liquid funds, using its saved exchange rate. If principal has not returned, cancel and review estimated receipts separately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请仅在本次利息实际到账后确认。若已到期，本操作同时确认本金已全额返还流动资金，沿用已存本金汇率。若本金尚未返还，请取消并单独核实预计利息收据。"
          }
        }
      }
    },
