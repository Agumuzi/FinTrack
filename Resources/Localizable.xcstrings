      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing transactions (including manually entered base amounts), financial rules, goals, starting assets, and monthly budgets will be recalculated from their original currency amounts. Preparation does not modify data. A native full backup is created before confirmation applies the change."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
