    "csv.guide.loans.rules": {
      "comment": "v1.5 pending English; structured CSV explanatory copy; protocol field names must stay byte-exact",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title: Loan name. Principal: Actual loan principal in the original currency, not the total purchase price including down payment. AnnualRate: Required annual percentage from 0 to 100, at most four decimal places.\nTermMonths: Required integer from 1 to 600; total number of monthly repayment periods.\nMethod: Must be exactly Equal Payment (equal total installments), Equal Principal (equal principal), or Interest Only (interest first, principal at maturity).\nStartDate: Date of the first repayment, not the contract signing date. Category: Repayment category.\nThis template defines a new complete repayment schedule; it does not indicate that any historical installment was paid. Do not guess historical repayments, outstanding balances, or down payments. If the source contains only a remaining balance or incomplete repayment history, ask the user before creating a new full schedule. Use a native backup or original-format export to restore full history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Title：贷款名称。Principal：实际贷款原币本金，不是含首付总价。AnnualRate：必填，0到100的年化百分数，最多四位小数。\nTermMonths：必填，1到600的整数，总期数/月数。\nMethod：仅 Equal Payment（等额本息）、Equal Principal（等额本金）、Interest Only（先息后本）。\nStartDate：第一期还款日期，不是合同签订日。Category：还款分类。\n此模板定义新的完整还款计划，不表示已有任何一期已还款；不猜测历史还款、余额或首付。若原表只有剩余余额或不完整的已还历史，请先向用户确认，不直接据此生成新完整计划。完整历史恢复使用原生备份或原格式数据文件。"
          }
        }
      }
    },
