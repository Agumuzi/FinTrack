    "All financial records and personal data entered in the app are stored locally on your device. The developer does not collect, store, or have access to your financial information.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All financial records and personal data entered in the app are stored locally on your device. The developer does not collect, store, or have access to your financial information."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все финансовые записи и личные данные, введённые в приложение, хранятся локально на вашем устройстве. Разработчик не собирает, не хранит и не имеет доступа к вашей финансовой информации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
