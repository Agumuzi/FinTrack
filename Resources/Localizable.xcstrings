          "stringUnit": {
            "state": "translated",
            "value": "旧贷款 · 只读核查"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старый кредит · проверка без изменений"
          }
        }
      }
    },
    "Original iOS generated receipts do not contain a stable loan UUID or installment ID. Similar dates, amounts and notes are NOT proof of payment. Nothing here changes your ledger.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original iOS generated receipts do not contain a stable loan UUID or installment ID. Similar dates, amounts and notes are NOT proof of payment. Nothing here changes your ledger."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原 iOS 自动生成的收据不含稳定的贷款或期次标识。相近的日期、金额和备注不能证明已还款。此处核查不会更改账本。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В старых квитанциях iOS нет устойчивого идентификатора кредита или платежа. Совпадение дат, сумм и заметок не доказывает оплату. Эта проверка не изменяет журнал."
          }
        }
      }
    },
    "Only accrued interest from this deposit will be posted as income; principal stays in the deposit. No automatic rollover or withdrawal.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only accrued interest from this deposit will be posted as income; principal stays in the deposit. No automatic rollover or withdrawal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅将此存款的应计利息记为收入，本金保留在存款中，不会自动续存或支取。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В доход будет записан только начисленный процент. Основная сумма остаётся во вкладе, без автоматического продления или снятия."
          }
        }
      }
    },
