    "csv.guide.recurring.rules": {
      "comment": "v1.5 pending English; structured CSV explanatory copy; protocol field names must stay byte-exact",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title: Rule name. Type: Must be Income or Expense. Amount: Original-currency amount per occurrence, not the total over multiple occurrences.\nIntervalValue: Integer from 1 to 365. IntervalUnit: Must be exactly day, week, month, or year in lowercase. For every two months, use 2,month.\nNextExecutionDate: Required date of the next pending occurrence. EndDate: Optional; if set, it cannot be earlier than the next execution date.\nImport creates a new managed recurring rule, paused by default. Review the next date before enabling the rule in the Recurring section. Importing does not fabricate historical executions or directly create transactions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Title：规则名称。Type：Income或Expense。Amount：每期原币金额，不能填写多期合计。\nIntervalValue：1到365的整数。IntervalUnit：仅 day、week、month、year（小写）。例如每2个月为2,month。\nNextExecutionDate：下一次待执行的日期，必填。EndDate：选填，若填写不能早于下一次日期。\n导入为新的受管理规则，默认暂停，核对下一次日期后在周期页面启用；不自动制造过去的执行记录，也不直接生成交易。"
          }
        }
      }
    },
