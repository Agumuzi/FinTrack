    "Interest accrues monthly, compounds into principal, and is settled at maturity": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interest accrues monthly, compounds into principal, and is settled at maturity"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проценты начисляются ежемесячно, капитализируются и выплачиваются в конце срока"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "利息按月计提并计入本金复利，到期统一结算"
          }
        }
      }
    },
    "Interest and exchange-rate snapshots are preserved using your selected dates.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interest and exchange-rate snapshots are preserved using your selected dates."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимки процентов и валютного курса сохраняются по выбранным вами датам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "利息和汇率快照会按照你选择的日期保留。"
          }
        }
      }
    },
    "Interest is calculated without monthly compounding and paid once at maturity": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interest is calculated without monthly compounding and paid once at maturity"
