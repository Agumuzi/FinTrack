    "Locally stored data may be removed from your device when the app is deleted. If iCloud Sync is enabled, your synced data may still remain available through Apple’s iCloud system.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locally stored data may be removed from your device when the app is deleted. If iCloud Sync is enabled, your synced data may still remain available through Apple’s iCloud system."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При удалении приложения локально сохранённые данные могут быть удалены с устройства. Если включена синхронизация iCloud, синхронизированные данные могут остаться доступными через систему iCloud Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
