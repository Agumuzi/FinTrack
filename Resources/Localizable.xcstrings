    "Loan and Deposit categories cannot be renamed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loan and Deposit categories cannot be renamed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категории кредита и вклада нельзя переименовывать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "贷款和存款分类不能重命名。"
          }
        }
      }
    },
    "Loan balance follows the saved repayment schedule; recorded payments and legacy histories can be reviewed in Finance.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loan balance follows the saved repayment schedule; recorded payments and legacy histories can be reviewed in Finance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаток кредита рассчитывается по сохранённому графику. Платежи и старую историю можно проверить в разделе «Финансы»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "贷款余额按原还款计划计算，可在财务页核对还款记录与旧历史。"
          }
        }
      }
    },
    "Loan payment receipts do not match the saved schedule or cash ledger. Review existing payments before recording another installment.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loan payment receipts do not match the saved schedule or cash ledger. Review existing payments before recording another installment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платежи не соответствуют графику или базе операций. Проверьте существующие платежи перед добавлением следующего."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还款记录与保存的计划或账本不一致，请先核对已有付款。"
          }
        }
      }
    },
