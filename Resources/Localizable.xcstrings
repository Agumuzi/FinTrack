    "mac.permissionCoordinator.MacFormShell.782c40df93": {
      "comment": "v1.5 pending English; Sources/App/Lifecycle/MacPermissionCoordinator.swift:145; Text, Text(\"开启需要授权的功能时会前往系统设置。关闭会立即停用本应用功能；通知和辅助功能的系统授权需在 macOS 中撤销。\").appFont, Text(\"开启需要授权的功能时会前往系统设置。关闭会立即停用本应用功能；通知和辅助功能的系统授权需在 macOS 中撤销。\").appFont(.caption).foregroundStyle",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabling a feature that requires permission opens System Settings. Disabling a feature immediately turns it off in FinTrack. System authorization for notifications and Accessibility must be revoked in macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启需要授权的功能时会前往系统设置。关闭会立即停用本应用功能；通知和辅助功能的系统授权需在 macOS 中撤销。"
          }
        }
      }
    },
