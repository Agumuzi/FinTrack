    "All data stays on this device. Cloud sync and third-party sign-in are disabled.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All data stays on this device. Cloud sync and third-party sign-in are disabled."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все данные хранятся только на этом устройстве. Облачная синхронизация и сторонний вход отключены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有数据仅保留在本机。云同步和第三方登录已禁用。"
          }
        }
      }
    },
