    "A category named \"%@\" already exists. Merge all data from \"%@\" into it?": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A category named \"%1$@\" already exists. Merge all data from \"%2$@\" into it?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Категория с именем \"%1$@\" уже существует. Объединить все данные из \"%2$@\" в эту категорию?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存在名为“%1$@”的分类。要将“%2$@”下的所有数据合并到该分类吗？"
          }
        }
      }
    },
