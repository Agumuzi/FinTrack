      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No future interest due"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无未来年份的未到账收益"
          }
        }
      }
    },
    "deposit.earnings.year.label": {
      "comment": "v1.5 deposit earnings addition. Read-only interest overview, original currency; planned settlement year, not cash-flow year.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 年"
          }
        }
      }
    },
    "deposit.earnings.basis": {
      "comment": "v1.5 deposit earnings addition. Read-only interest overview, original currency; planned settlement year, not cash-flow year.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All deposits, grouped by original currency and scheduled payment year. Forecasts exclude principal. Pending review entries are not confirmed payments."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "统计全部存款，按原币种和计划结息年份汇总，不含本金。待核对收入不视为实际到账。"
          }
        }
      }
    },
    "deposit.earnings.outstanding.help": {
      "comment": "v1.5 deposit earnings addition. Read-only interest overview, original currency; planned settlement year, not cash-flow year.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uncollected interest across all years, including overdue payments and explicitly recorded partial payments."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有年份尚未到账的预计利息，包含逾期未到账和明确标记为部分到账的剩余利息。"
          }
        }
      }
    },
    "deposit.earnings.current.help": {
      "comment": "v1.5 deposit earnings addition. Read-only interest overview, original currency; planned settlement year, not cash-flow year.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Total = received + outstanding, assigned to the scheduled payment year. Final bank adjustments replace that payment’s forecast."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当年总计＝已到账＋未到账，按计划结息年份归属。最终核对金额替代该笔结息的预计金额。"
          }
        }
      }
    },
    "deposit.earnings.future.help": {
      "comment": "v1.5 deposit earnings addition. Read-only interest overview, original currency; planned settlement year, not cash-flow year.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Outstanding interest scheduled for next year or later, listed in ascending order."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一年及以后计划结息但尚未到账的收益，按年份升序排列。"
          }
        }
      }
    },
    "deposit.earnings.review": {
      "comment": "v1.5 deposit earnings addition. Read-only interest overview, original currency; planned settlement year, not cash-flow year.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deposits to review: %lld. Uncertain amounts are excluded; stopped deposits include only identifiable receipts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 笔存款需要核查：不确定的金额未计入；提前结束的存款仅计入可确认的到账记录。"
          }
        }
      }
    },
    "deposit.earnings.partial.label": {
      "comment": "v1.5 deposit earnings addition. Read-only interest overview, original currency; planned settlement year, not cash-flow year.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More interest is still due"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍有利息待收（部分到账）"
          }
        }
      }
    },
    "deposit.earnings.partial.help": {
      "comment": "v1.5 deposit earnings addition. Read-only interest overview, original currency; planned settlement year, not cash-flow year.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the total received so far for this payment. Select this only if the bank still owes the remainder. Leave it off for a final amount adjustment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写该笔结息截至目前累计实际到账金额。仅在银行仍应支付剩余利息时勾选；最终金额调整请勿勾选。"
          }
        }
      }
    },
    "deposit.earnings.partial.invalid": {
      "comment": "v1.5 deposit earnings addition. Read-only interest overview, original currency; planned settlement year, not cash-flow year.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A partial payment must be less than the scheduled interest."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分到账金额必须小于该笔计划结息金额。"
          }
        }
      }
    },
    "deposit.earnings.partial.status": {
      "comment": "At least one confirmed interest receipt is explicitly partial; more interest is still due.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partial payments · Interest still due"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分到账，仍有利息待收"
          }
        }
      }
    },
    "deposit.earnings.expand": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show interest overview"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "展开收益概览"
          }
        }
      }
    },
    "deposit.earnings.collapse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide interest overview"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收起收益概览"
          }
        }
      }
    },
    "deposit.earnings.expanded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expanded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已展开"
          }
        }
      }
    },
    "deposit.earnings.collapsed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collapsed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已收起"
          }
        }
      }
    },
    "liquidity.initialize": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm current liquid funds"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认当前流动资金"
          }
        }
      }
    },
    "liquidity.calibrate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibrate current liquid funds"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "校准当前流动资金"
          }
        }
      }
    },
    "liquidity.current": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current liquid funds"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前流动资金"
          }
        }
      }
    },
    "liquidity.initialize.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back up your ledger before updating. Enter the cash you can actually use now, excluding deposits. The suggested amount is unconfirmed. Existing history is preserved. Review ended deposits with uncertain settlement separately; their principal is not assumed returned. Verify interest already received before confirming the balance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "升级前请保留旧版完整备份。请输入当前真实可动用资金，不含存款本金。建议金额尚未确认，历史数据保留。结束状态不明的旧存款请单独核对，不推定本金已返还。 请先核实已到账利息，再确认余额。"
          }
        }
      }
    },
    "liquidity.calibrate.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the actual balance, including a negative balance if needed. Calibration records a difference without changing income, expenses or net. CSV does not preserve internal movements: calibrate after importing historical deposits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入实际余额，允许负数。校准记录差额，不改变收入、支出或净额。CSV不保存内部资金流转，导入历史存款后请核对并校准。"
          }
        }
      }
    },
    "liquidity.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Liquid funds await confirmation — review balance"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "流动资金尚未确认，点此核对余额"
          }
        }
      }
    },
    "liquidity.return": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm principal returned"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认本金已返还"
          }
        }
      }
    },
    "liquidity.return.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full principal received"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本金已全额到账"
          }
        }
      }
    },
    "liquidity.return.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm only after the bank has actually returned the full principal below. Interest must be verified separately. This action is recorded once using the saved principal exchange rate. Partial principal returns require separate review; do not confirm full return."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在银行已实际全额返还以下本金时确认。利息需单独核实。本操作使用已存本金汇率，仅记录一次。部分本金返还需另行核对，请勿确认全额返还。"
          }
        }
      }
    },
    "liquidity.renewal.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm the source principal has actually returned and verify any estimated interest before renewing. Unknown historical settlements require balance calibration and a new deposit instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先确认原存款本金实际返还，并核实预计利息后再续存。结算不明的历史存款请校准余额后使用新建存款。"
          }
        }
      }
    },
    "liquidity.invalid.cash": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid liquid-funds balance (up to 1 trillion in magnitude). Grouped amounts such as 1,234.56 are accepted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的流动资金余额，绝对值不超过一万亿；支持 1,234.56 格式。"
          }
        }
      }
    },
    "liquidity.invalid.debt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid nonnegative manual debt amount. If you have no debt, enter 0.00."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入有效的非负手工负债金额；没有负债请填 0.00。"
          }
        }
      }
    },
    "liquidity.manual.debt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual debt (0.00 if none)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手工负债（没有则填 0.00）"
          }
        }
      }
    },
    "liquidity.busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled posting is in progress. Try saving the balance again shortly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在处理计划入账，请稍后再次保存余额。"
          }
        }
      }
    },
