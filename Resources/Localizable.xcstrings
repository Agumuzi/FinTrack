    "insights.axis.month.explanation": {
      "comment": "v1.5 UI review: display only; leaves stored period and flow identities unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The horizontal axis shows the month number within each period. Periods are aligned by position; missing months in the shorter period are not filled with zeros."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "横轴为各期间内的月份序号，按位置对齐；较短期间缺少的月份不补零。"
          }
        }
      }
    },
    "insights.axis.day.explanation": {
      "comment": "v1.5 UI review: display only; leaves stored period and flow identities unchanged.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The horizontal axis shows the day number within each period. Periods are aligned by position; missing days in the shorter period are not filled with zeros."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "横轴为各期间内的日期序号，按位置对齐；较短期间缺少的日期不补零。"
          }
        }
      }
    },
